{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Steam user literal",
            "patterns": [
              "/\\bpen4216\\b/"
            ]
          },
          {
            "name": "steamcmd login user literal",
            "patterns": [
              "/steamcmd\\s+\\+login\\s+(?<steam_user>(?!<[^>]+>|\"?\\$[A-Za-z_][A-Za-z0-9_]*\"?|anonymous\\b)[A-Za-z0-9_.@-]{3,})(?=\\s+\\+)/i"
            ]
          },
          {
            "name": "steamcmd workshop local VDF path",
            "patterns": [
              "/steamcmd\\s+\\+login\\s+\\S+\\s+\\+workshop_build_item\\s+(?<workshop_item_path>/Users/[^\\s`\"']*dist/workshop/workshop_item\\.vdf)/i"
            ]
          },
          {
            "name": "STEAM_USER concrete assignment",
            "patterns": [
              "/\\bSTEAM_USER\\s*=\\s*(?<steam_user>(?!<redacted>|masked|\\$STEAM_USER|\\.\\.\\.)[A-Za-z0-9_.-]{3,})\\b/"
            ]
          },
          {
            "name": "password assignment",
            "patterns": [
              "/\\b(?:STEAM_PASSWORD|PASSWORD|password|passwd|pwd)\\s*=\\s*(?<password>(?!<redacted>|masked|\\$[A-Za-z_][A-Za-z0-9_]*|\\.\\.\\.)[^\\s`\"']{3,})/i"
            ]
          },
          {
            "name": "steamcmd login password argument",
            "patterns": [
              "/steamcmd\\s+\\+login\\s+(?:\"?\\$STEAM_USER\"?|<user>|\\S+)\\s+(?<steam_password>(?!\\+[A-Za-z_]|<password>|\\$STEAM_PASSWORD|\\$[A-Za-z_][A-Za-z0-9_]*|\\.\\.\\.)[^\\s`\"']{3,})/i"
            ]
          }
        ]
      }
    }
  ]
}
